# Host configuration for local dev registry
host "localhost:8080" {
  services = {
    "providers.v1" = "http://localhost:8080/v1/providers/",
    "modules.v1" = "http://localhost:8080/v1/modules/",
  }
  insecure = true  # Allow HTTP instead of HTTPS
}

